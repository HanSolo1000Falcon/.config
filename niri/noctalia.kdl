layout {

    focus-ring {
        active-color   "#97d5a5"
        inactive-color "#101510"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#97d5a5"
        inactive-color "#101510"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#97d5a5"
        inactive-color "#15512c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#97d5a580"
    }
}

recent-windows {
    highlight {
        active-color "#97d5a5"
        urgent-color "#ffb4ab"
    }
}
