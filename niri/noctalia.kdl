layout {

    focus-ring {
        active-color   "#afd18c"
        inactive-color "#11140e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#afd18c"
        inactive-color "#11140e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#afd18c"
        inactive-color "#324e18"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#afd18c80"
    }
}

recent-windows {
    highlight {
        active-color "#afd18c"
        urgent-color "#ffb4ab"
    }
}
