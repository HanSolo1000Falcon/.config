layout {

    focus-ring {
        active-color   "#9acbfa"
        inactive-color "#101418"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9acbfa"
        inactive-color "#101418"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#9acbfa"
        inactive-color "#0b4a72"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9acbfa80"
    }
}

recent-windows {
    highlight {
        active-color "#9acbfa"
        urgent-color "#ffb4ab"
    }
}
