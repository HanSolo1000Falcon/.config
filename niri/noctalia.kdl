layout {

    focus-ring {
        active-color   "#eebf6d"
        inactive-color "#17130b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#eebf6d"
        inactive-color "#17130b"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#eebf6d"
        inactive-color "#5e4200"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#eebf6d80"
    }
}

recent-windows {
    highlight {
        active-color "#eebf6d"
        urgent-color "#ffb4ab"
    }
}
