layout {

    focus-ring {
        active-color   "#94cdf6"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#94cdf6"
        inactive-color "#101417"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#94cdf6"
        inactive-color "#004c6d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#94cdf680"
    }
}

recent-windows {
    highlight {
        active-color "#94cdf6"
        urgent-color "#ffb4ab"
    }
}
