layout {

    focus-ring {
        active-color   "#67e46b"
        inactive-color "#0e2f0f"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67e46b"
        inactive-color "#0e2f0f"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67e46b"
        inactive-color "#148517"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67e46b80"
    }
}

recent-windows {
    highlight {
        active-color "#67e46b"
        urgent-color "#fd4663"
    }
}
