layout {

    focus-ring {
        active-color   "#58f3d7"
        inactive-color "#043938"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#58f3d7"
        inactive-color "#043938"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#58f3d7"
        inactive-color "#099077"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#58f3d780"
    }
}

recent-windows {
    highlight {
        active-color "#58f3d7"
        urgent-color "#fd4663"
    }
}
